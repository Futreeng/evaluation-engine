# Futreeng Growth Engine — Environment Configuration

## Server
PORT=3001
NODE_ENV=development

## Database
DB_PATH=./server/data/convergence.db
# For production, switch to Postgres:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=futreeng_production
# DB_USER=futreeng_user
# DB_PASSWORD=your_secure_password

## Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

## Social Media API Keys
# Instagram Graph API (Business Account)
INSTAGRAM_TOKEN=your_instagram_business_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id

# TikTok API
TIKTOK_API_KEY=your_tiktok_api_key
TIKTOK_API_SECRET=your_tiktok_api_secret

# Twitter/X API v2
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Facebook Graph API
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

## LLM API Keys (for Convergence)
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

## Convergence
CONVERGENCE_URL=http://localhost:3001/convergence
# If running Convergence on separate server:
# CONVERGENCE_URL=http://convergence.example.com

## Job Queue
# For MVP (in-memory): no configuration needed
# For production (Bull + Redis):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

## Stripe (for payment processing)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

## Logging
LOG_LEVEL=debug
# Set to "production" in prod for less verbose logging

## CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://futreeng.com

## Email (for audit notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@futreeng.com
SMTP_PASSWORD=your_email_password
