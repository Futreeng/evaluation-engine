# Scalecraft / Growth Engine backend — copy to .env and fill in.
# Never commit .env.

# --- required ---------------------------------------------------------------
PORT=3005
NODE_ENV=development
# 32+ random bytes each: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# --- database ---------------------------------------------------------------
# Leave empty locally → sql.js file at server/data/growth_engine.db
# Set on Railway/hosted → PostgreSQL (schema is created on boot)
DATABASE_URL=

# --- profile data -----------------------------------------------------------
# Reads any public Instagram profile (~$0.003 per evaluation). Required for
# the free funnel; without it the Graph API fetcher below is used instead.
APIFY_TOKEN=
# Instagram Graph API — only reads business accounts you've connected.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# X / Twitter API v2 (paid tier required for lookups)
TWITTER_BEARER_TOKEN=

# --- LLM keys (at least one; tried in this order) ---------------------------
CLAUDE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=groq/compound

# --- billing ----------------------------------------------------------------
# Empty → mock subscriptions (no card)
STRIPE_API_KEY=

# --- email (Resend) --------------------------------------------------------
# Unset → every send is logged, nothing goes out. resend.com free tier: 3k/mo.
RESEND_API_KEY=
# Must be on a domain verified in Resend
MAIL_FROM="Scalecraft <hello@futreeng.com>"
# Public origin used in email links
APP_URL=http://localhost:3005
# resend | log. Default: resend when RESEND_API_KEY is set, else log.
EMAIL_PROVIDER=
# Physical mailing address, required in every non-transactional email (CAN-SPAM).
EMAIL_POSTAL_ADDRESS=

# Shown in the site footer, legal pages and email footers. Empty → hidden.
SUPPORT_EMAIL=hello@futreeng.com
# Founders pricing is automatic (see FOUNDERS_CAP below). Promo codes are for comps and campaigns only:
#   node scripts/promo.js create WELCOME1 --kind free_months --value 1 --max 50
# Admins: these signed-in accounts get the Admin page (#/admin) and /admin/* routes.
ADMIN_EMAILS=
# Script/curl access to /admin/* (header x-admin-token). Either this or ADMIN_EMAILS, else 404.
ADMIN_TOKEN=

# --- product knobs ----------------------------------------------------------
# Free Snapshot is one per handle, ever. Set to "unlimited" for local testing
# and the smoke test (scripts/smoke.js with SMOKE_FREE_UNLIMITED=1).
FREE_SNAPSHOTS_PER_EMAIL=1
# Evaluations (free or paid) one IP address may start per hour.
EVALS_PER_IP_PER_HOUR=10

# Posts scored per account (12–50). Instagram: the first ~12 come with the
# profile pull; the rest cost ≈$0.0023 each. TikTok: ≈$0.004 per video.
SCRAPE_POSTS=30
# Posting Consistency is judged on posts within this many days, so scrape
# depth doesn't change the score. Engagement and Content Mix use every post.
CADENCE_WINDOW_DAYS=90

# --- post thumbnails (spec 1.4) -------------------------------------------
# Our own 320px WebP copies of post images; scraper URLs are never stored.
# THUMB_STORAGE=local          server/data/thumbs served at /thumbs (dev / ephemeral)
# THUMB_STORAGE=s3             any S3-compatible bucket; npm i @aws-sdk/client-s3
# S3_BUCKET= S3_ENDPOINT= S3_REGION=auto S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE=https://<bucket public host>
# THUMB_WIDTH=320 THUMB_QUALITY=75 THUMB_TIMEOUT_MS=4000 THUMB_CONCURRENCY=6
# THUMB_FREE_TTL_DAYS=90       free reports lose their thumbnails after this
# THUMBS_DISABLED=true         skip downloads entirely

# --- post writing (spec 1.12) ---------------------------------------------
# NEXT_POSTS_COUNT=6            posts written with every paid report
# POST_REGENS_PER_DAY=20        single-post rewrites per account per day

# --- cost controls (defaults shown) --------------------------------------
# PAID_RUNS_PER_DAY=5             on-demand evaluations per paid account per day
# COMPETITOR_PULLS_PER_DAY=15     competitor profile pulls per account per day
# FREE_RUNS_PER_DAY_GLOBAL=500    free scores across everyone per day
# REFRESH_INTERVAL_MIN=30         how often the weekly-refresh sweeper looks for due reports
# REFRESH_BATCH=10                max refreshes per sweep
# REFRESH_DISABLED=true           turn the sweeper off locally
# BASELINE_MIN_N=10              accounts a niche needs before its average shows on reports

# --- pricing add-on (P.1–P.4) -----------------------------------------------
# Prices, limits and feature lists live in growth_engine_plans.js; override without a deploy:
# PLAN_PRICES_JSON={"growth_plan":{"monthly":1900,"annual":19000},"growth_plan_pro":{"monthly":3900,"annual":39000}}
# PLAN_LIMITS_JSON={"growth_plan":{"post_regens_per_week":10,"post_reviews_per_week":7,"written_posts_per_week":6,"competitor_handles":5,"rescore_days":7}}
# FOUNDERS_CAP=400                first N paid Growth subscribers lock the launch price (P.2)
# FOUNDERS_GROWTH_MONTHLY=1200    FOUNDERS_GROWTH_ANNUAL=10800
# LEGACY_GROWTH_PRICE_CENTS=1200  pre-update subscribers with no stored price keep this (P.3)
# ENABLE_ONE_TIME_UNLOCK=true     re-enable the old $15 60-day unlock (off: P.8 earmarks a one-time product)
# Stripe (Joe): create NEW Price objects for 1900/19000/3900/39000/500 and the founders 1200/10800;
# never edit or delete existing ones — current subscriptions keep theirs.

# --- price A/B test (spec 1.14, P.7) -------------------------------------------
# Growth test once live: $15 / $19 / $24 monthly (founders pricing is excluded — it applies before the variant):
# PRICE_VARIANTS_JSON={"control":{"weight":34,"growth_plan":1900},"low":{"weight":33,"growth_plan":1500},"high":{"weight":33,"growth_plan":2400}}
# Report: GET /admin/price-test?days=30 (conversion, revenue per visitor, month-two retention).
# Unset → one price for everyone. Each variant may override growth_plan
# (cents/month) and plan_unlock (cents); weights split new visitors; a
# visitor keeps their variant, and it's copied onto the account at signup.
# PRICE_VARIANTS_JSON={"control":{"weight":50},"lower":{"weight":50,"growth_plan":900,"plan_unlock":1200}}

# --- testing ----------------------------------------------------------------
# Runs the full Growth Plan pipeline for everyone, skips report ownership
# checks and skips per-day run metering. LOCAL TESTING ONLY — on a public
# deployment every anonymous visitor triggers a profile pull + LLM calls.
# DEV_UNLOCK_ALL=true

# --- feature flags (off until the feature delivers) -----------------------
# ENABLE_BADGES=true              badges for real milestones on the report + cards (spec 4.6)
# BADGES_JSON=[{"key":"first_1k"},{"key":"first_3x"},{"key":"streak_12"},{"key":"dim_90"}]   subset of the built-in badge keys
# ENABLE_QUESTS=true              weekly quest from the calendar, checked at the rescore (spec 4.7)
# ENABLE_GROWTH_PLAN_PRO=true     shows + sells the $29 multi-platform tier
# ENABLE_BUSINESS_CHECKOUT=true   sells the business tiers (otherwise: lead form)

# --- roast (spec 2.1) ------------------------------------------------------
# ROAST_ENABLED=true              opt-in roast mode on every report (free)
# ROAST_LINES=6                   jokes per roast (3–10)
# ROAST_REROAST_DAYS=30           days before "roast me again" (then vs now)
# ROASTS_PER_IP_PER_HOUR=6        roast generations per connection per hour
# ROAST_MINOR_PATTERNS=           extra regex alternatives that mark a bio as under 18
# ROAST_BLOCK_PATTERNS=           extra regex alternatives the safety screen rejects

# --- win-back (spec 4.4) ----------------------------------------------------
# WINBACK_ENABLED=true            one snapshot rescore + email at each milestone after a cancel takes effect
# WINBACK_DAYS=30,60              days after lapse; product_news opt-in only
# WINBACK_BATCH=5                 rescores queued per sweep

# --- cancel flow (spec 4.1–4.3) --------------------------------------------
# PAUSE_MAX_MONTHS=3              pause options offered before cancelling (1..N)
# MAINTENANCE_PRICE_CENTS=500     maintenance tier: weekly rescore + history only

# --- 48-hour post review (spec 3.1, paid) ---------------------------------
# POST_REVIEW_ENABLED=true
# POST_REVIEW_CHECK_HOURS=60      how often each paid account is re-read for new posts (one profile pull)
# POST_REVIEW_AGE_HOURS=48        a post is reviewed once it's this old
# POST_REVIEW_MAX_AGE_DAYS=14     older than this is never reviewed
# POST_REVIEW_PER_CHECK=2         reviews written per account per check
# POST_REVIEW_BATCH=10            accounts checked per sweep

# --- aggregate stats / benchmarks (spec 5.3, 5.4) --------------------------
# STATS_WINDOW_DAYS=180           reports this old still count in niche stats and public benchmarks
# (gated by BASELINE_MIN_N)

# --- weekly trend brief (spec 3.4) ----------------------------------------
# BRIEF_WINDOW_DAYS=90            reports this old still count toward a niche's brief
# BRIEF_TOP_LIFT=1.5              a post is "top" when it beats its own account's median by this
# (gated by BASELINE_MIN_N — same rule as the niche average)

# --- Monday move (spec 2.6) ------------------------------------------------
# MONDAY_MOVE_ENABLED=true        one move under 15 min every Monday morning (user's tz)
# MONDAY_MOVE_HOUR=8              local hour the 4-hour send window opens
# MONDAY_MOVE_MAX_MIN=15          prefer moves whose time estimate is at or under this
# MONDAY_MOVE_LOOKBACK_DAYS=100   how far back a report can be and still get Mondays

# --- levels + milestones (spec 2.2, 2.5) ---------------------------------
# SCORE_LEVELS=Rookie:0,Rising:40,Consistent:55,Established:70,Elite:85   name:min, ascending
# MILESTONE_FOLLOWERS=1000        first follower milestone card
# MILESTONE_SCORE=70              score milestone card
# MILESTONE_STREAK_WEEKS=4        on-plan weeks for the streak card (2.3)
# RECORD_METRIC=engagement        personal records (2.4): engagement (likes+comments) or views
# STREAK_FREEZE_EVERY_WEEKS=4     a freeze is earned every N on-plan weeks (2.3)
# STREAK_MAX_FREEZES=2            freezes an account can hold
# STREAK_START_FREEZES=1          freezes a new plan starts with
