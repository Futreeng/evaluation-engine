{
  "name": "convergence-app",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "server/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "cd server && npm run dev",
    "test": "node server/growth_engine_path.test.js && node server/growth_engine_db_postgres.test.js",
    "check": "for f in server/*.js server/routes/*.js public/*.js; do node --check \"$f\" || exit 1; done",
    "smoke": "node server/scripts/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "sql.js": "^1.14.2",
    "stripe": "^14.12.0",
    "uuid": "^14.0.2"
  }
}
