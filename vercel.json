{
  "buildCommand": "echo 'Static deployment ready'",
  "devCommand": "python -m http.server 3000",
  "name": "futreeng-growth-engine",
  "public": "public",
  "env": {
    "NEXT_PUBLIC_API_BASE": {
      "description": "Growth Engine API base URL",
      "default": "http://localhost:3000/api/growth-engine/v1"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "$NEXT_PUBLIC_API_BASE/:path*"
    }
  ]
}
